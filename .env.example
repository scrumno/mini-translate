# Debug logging (backend). Set to true or 1 to enable.
TRANSLATOR_DEBUG=false

# AnkiConnect (default: http://127.0.0.1:8765)
ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_DECK_WORDS=English/Words/Default
ANKI_DECK_PHRASES=English/Phrases
ANKI_NOTE_TYPE_WORDS=TranslatorWord
ANKI_NOTE_TYPE_PHRASES=TranslatorPhrase

# Obsidian: path to vault root (e.g. /home/user/Documents/ObsidianVault)
# Leave empty to disable file-based export.
OBSIDIAN_VAULT_PATH=C:\\knowledge-obsidian

# Obsidian Local REST API (optional). If set, used instead of direct file write.
# OBSIDIAN_API_URL=https://127.0.0.1:27124
# OBSIDIAN_API_KEY=your-api-key
